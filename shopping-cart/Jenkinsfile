def mavenContainer = 'maven'
def appDir = 'shopping-cart'

pipeline {
    agent {
        kubernetes {
            inheritFrom mavenContainer
            defaultContainer mavenContainer
            serviceAccount 'jenkins'
        }
    }
    environment {
        APP_NAMESPACE = 'igalrq-security-scans'
    }
    stages {
        stage('Test') {
            steps {
                dir(appDir) {
                    sh './mvnw -B clean test'
                }
            }
        }
        stage('Download oc tool') {
            steps {
                dir(appDir) {
                    sh '''
                        curl -L \
                            https://mirror.openshift.com/pub/openshift-v4/clients/ocp/latest/openshift-client-linux.tar.gz \
                            | tar xvz
                        chmod +x oc
                        export PATH=$PATH:$(pwd)
                        oc version
                    '''
                }
            }
        }
        stage('Image Build') {
            steps {
                dir(appDir) {
                    sh """
                        export PATH=\$PATH:\$(pwd)
                        oc version
                        oc start-build security-scans \
                            --follow --wait -n ${APP_NAMESPACE}
                    """
                }
            }
        }
        stage('Deploy') {
            steps {
                dir(appDir) {
                    sh """
                        oc patch deployment security-scans \
                            -p '{"spec": {"template": {"metadata": {"labels": {"build": "build-${BUILD_NUMBER}"}}}}}' \
                            -n ${APP_NAMESPACE}
                    """
                }
            }
        }
    }
}